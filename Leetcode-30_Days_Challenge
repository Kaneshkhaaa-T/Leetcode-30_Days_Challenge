                 arr[1] = intervals[i][1];
                }
            }
           else {
            merged.add(arr);
            arr = intervals[i]; 
}

        }
         merged.add(arr);
        return merged.toArray(new int[merged.size()][]);

    }
}

88. Merge Sorted Array

class Solution {
    public void merge(int[] nums1, int m, int[] nums2, int n) {
        int i = m-1;
        int j = n-1;
        int ind = m+n-1;
        while(j>=0){
            if(i>=0 && nums1[i]>=nums2[j]){
                nums1[ind] = nums1[i];
                i--;
                ind--;
            }
            else{
                nums1[ind] = nums2[j];
                j--;
                ind--;
            }
        }
    }
}

287. Find the Duplicate Number

class Solution {
    public int findDuplicate(int[] nums) {
        int n = nums.length;
        int[] hash = new int[n];
        int ans = -1;
        for(int i =0;i<n;i++){
            hash[nums[i]]++;
            if(hash[nums[i]]>1){
                ans =  nums[i];
                break;
            }
        }
        return ans;
    }
}

